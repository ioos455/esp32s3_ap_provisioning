#ifndef __WIFI_SECRETS_H_
#define __WIFI_SECRETS_H_

/*
 * 敏感配置模板
 *
 * 本文件会被 git 跟踪；同目录下的 wifi_secrets.h 保存真实凭据，已被 .gitignore 忽略。
 * 首次编译时由 CMake 自动把本文件复制为 wifi_secrets.h。
 *
 * 使用前请按自己的网络修改（若使用 CMake 自动生成，直接改 wifi_secrets.h 即可）：
 */

/* 设备要连接的上级 Wi-Fi（STA 模式） */
#define WIFI_SECRET_STA_SSID            "YOUR_WIFI_SSID"
#define WIFI_SECRET_STA_PASSWORD        "YOUR_WIFI_PASSWORD"

/* 设备自身开放的热点（AP 模式），供手机连接后进行配网 */
#define WIFI_SECRET_AP_SSID             "ESP32S3_AP"
#define WIFI_SECRET_AP_PASSWORD         "12345678"

#endif
